# The build context is the repo root (infra/Dockerfile). Keep it small
# and keep data out: the ONLY data path into the image is the staging
# directory infra/data-stage/, which the deploy workflow populates from
# the private bucket (ADR-0007). A local `make data` output must never
# ride in implicitly.
.git
.venv
node_modules
apps/web/node_modules
apps/web/dist
data
.pytest_cache
.ruff_cache
htmlcov
**/__pycache__
