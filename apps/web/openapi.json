  "info": {
    "description": "Aggregate statistics from the Global Flourishing Study, Waves 1-2. Every estimate carries its survey weight, design-based CI, unweighted n and suppression flags. Data: https://doi.org/10.17605/OSF.IO/3JTZ8",
    "title": "Flourish Atlas API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness probe for Cloud Run and uptime monitoring.\n\n``status`` reports the process; ``data`` is honest about whether a\nDuckDB file is baked into this deployment (CI images have none).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/aggregate": {
      "get": {
        "description": "One outcome at one wave, grouped and filtered. Every row carries\nthe weight, SE method, unweighted n, CI and suppression flags; the\nweight itself is resolved from the wave→weight→eligibility table,\nnever chosen here.",
        "operationId": "aggregate_v1_aggregate_get",
        "parameters": [
          {
            "in": "query",
            "name": "outcome",
            "required": true,
            "schema": {
              "title": "Outcome",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "wave",
            "required": true,
            "schema": {
              "title": "Wave",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "stat",
            "required": false,
            "schema": {
              "default": "mean",
              "title": "Stat",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "by",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "By"
            }
          },
          {
            "in": "query",
            "name": "filter",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Filter"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "default": "global",
              "title": "Scope",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "oriented",
            "required": false,
            "schema": {
              "default": false,
              "title": "Oriented",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "p",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
